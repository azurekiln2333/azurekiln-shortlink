# Optional compatibility for previously shared pretty URLs.
<IfModule mod_rewrite.c>
    RewriteEngine on
    RewriteRule ^about/?$ about.php [L]
    RewriteRule ^api-about/?$ api-about.php [L]
    RewriteRule ^contact/?$ contact.php [L]
    RewriteRule ^tos/?$ tos.php [L]
    RewriteRule ^404/?$ 404.php [L]
    RewriteRule ^([^/.]+)/?$ link.php?id=$1 [L,QSA]
</IfModule>

Options -Indexes
# Use the server's default error pages so subdirectory installs also work.

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
