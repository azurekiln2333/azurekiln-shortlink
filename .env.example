# Compose deployment settings. Copy to .env and fill in real values:
#   cp .env.example .env

# --- deployment ---
# Compose project name, also the watchtower scope: keep it stable per stack.
COMPOSE_PROJECT_NAME=azurekiln-link
# Image to run; CI publishes :vX.Y.Z plus :latest for non-prerelease v* tags.
APP_IMAGE=ghcr.io/azurekiln2333/azurekiln-shortlink:latest
# Loopback-only by default so a host reverse proxy owns TLS. Expose directly
# with APP_BIND_HOST=0.0.0.0 and APP_PORT=80.
APP_BIND_HOST=127.0.0.1
APP_PORT=8080
# Watchtower polls the registry for newer images every N seconds.
WATCHTOWER_POLL_INTERVAL=600
# Set to 1 after running the installer so /install/i.php refuses requests.
APP_INSTALL_LOCK=0

# --- application (environment overrides config.php) ---
APP_DEBUG=0

# Bridge networking: host.docker.internal resolves to the host gateway, so
# MySQL on the host must listen beyond 127.0.0.1 (bind-address) and its user
# must be granted access from the Docker bridge subnet. See README.
SHORTNY_DB_HOST=host.docker.internal
SHORTNY_DB_USER=
SHORTNY_DB_PASS=
SHORTNY_DB_NAME=

# OAuth2: discovery issuer, or the three explicit provider endpoints below.
OAUTH2_ISSUER=
OAUTH2_AUTHORIZATION_ENDPOINT=
OAUTH2_TOKEN_ENDPOINT=
OAUTH2_USERINFO_ENDPOINT=
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
# Register both complete URLs with the provider, including query strings.
# https://your-domain/admin/login.php?op=oauth2_callback
OAUTH2_REDIRECT_URI=
# https://your-domain/account.php?op=oauth2_callback
OAUTH2_USER_REDIRECT_URI=
OAUTH2_SCOPES=openid profile email
# Comma-separated administrator emails or stable OAuth2 subjects.
OAUTH2_ADMIN_EMAILS=
OAUTH2_ADMIN_SUBJECTS=
ALLOW_LEGACY_ADMIN_LOGIN=0

# API: comma-separated allowed browser origins; empty means same-origin only.
SHORTNY_API_ORIGINS=

# Analytics: enable with '1'; a blank salt disables visitor IP hashes.
SHORTNY_ANALYTICS_ENABLED=1
SHORTNY_ANALYTICS_SALT=
SHORTNY_ANALYTICS_RETENTION_DAYS=180
